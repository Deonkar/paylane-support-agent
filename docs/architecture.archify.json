    {
      "dot": "emerald",
      "title": "The model talks",
      "items": [
        "Gemini holds the conversation and picks tools",
        "Card numbers are redacted before it sees a message",
        "Replies pass an outbound filter for emails and cards"
      ]
    },
    {
      "dot": "violet",
      "title": "Jev judges",
      "items": [
        "Fraud, legal, closure, override: four yes/no probabilities per message",
        "At 0.5 or above, refunds stop for the rest of the chat",
        "If Jev fails, refunds pause (fail closed)"
      ]
    },
    {
      "dot": "rose",
      "title": "The code decides",
      "items": [
        "Verify first; one customer per chat",
        "Refund only if <= $75, under 30 days, settled, never refunded",
        "A blocked call never reaches the API and counts as an eval failure"
      ]
    }
