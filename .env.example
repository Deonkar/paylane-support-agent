# Copy to .env and fill in. Never commit .env.

# Required for live runs. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Turns on Jev (runtime triggers, eval grading, doc audits). https://typesafe.ai
TYPESAFE_API_KEY=

# Optional. Default gemini-3.5-flash-lite (fast, free tier). gemini-3.8-flash is stronger but was overloaded (503/504) when tested.
GEMINI_MODEL=

# Optional. Gemini requests per minute (free tier allows 15 per model).
GEMINI_RPM=
