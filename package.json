{
  "name": "paylane-support-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A policy-following support agent for a fictional fintech, with a tool gateway, Jev-judged triggers, an eval suite and an inspectable UI.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p e2e/tsconfig.json",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "audit": "pnpm audit --prod",
    "smoke:gemini": "node scripts/smoke-gemini.ts",
    "chat": "node src/cli/chat.ts",
    "eval": "node src/cli/eval.ts",
    "playground": "pnpm build && node src/cli/playground.ts",
    "build": "vite build web",
    "dev:web": "vite web",
    "jev": "node src/cli/jev.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "@google/genai": "2.28.0",
    "@typesafe-ai/sdk": "0.6.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.33.0"
}
