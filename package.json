{
  "name": "paylane-support-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A policy-following support agent for a fictional fintech, with a tool gateway, Jev-judged triggers, an eval suite and an inspectable UI.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "audit": "pnpm audit --prod",
    "smoke:gemini": "node scripts/smoke-gemini.ts",
    "chat": "node src/cli/chat.ts"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.33.0"
}
